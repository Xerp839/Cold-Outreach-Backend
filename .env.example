# ---------- App ----------
# Supabase -> Project Settings -> Database -> Connection string -> "Session pooler" (Render has no IPv6, so not "Direct")
DATABASE_URL=postgresql://postgres.xxxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Any long random string. Used by the dashboard and the GitHub Actions cron. (python -c "import secrets;print(secrets.token_urlsafe(32))")
API_KEY=change-me
FRONTEND_ORIGINS=http://localhost:5173,https://your-dashboard.vercel.app

# ---------- You ----------
CANDIDATE_NAME=Anish Patil
CANDIDATE_PHONE=+91-XXXXXXXXXX
CANDIDATE_LINKEDIN=https://linkedin.com/in/anish-patil
CANDIDATE_PORTFOLIO=https://anish-patil.netlify.app
CANDIDATE_GITHUB=https://github.com/Xerp839
# Drive file must be shared as "Anyone with the link". Used in emails AND read by the scorer.
RESUME_URL=https://drive.google.com/file/d/1tWLhTlrT_Q90u8oYWKJeLMw-gXYIDP4n/view?usp=sharing
CANDIDATE_CURRENT_ROLE=AI Engineer
CANDIDATE_CURRENT_COMPANY=Quantal
CANDIDATE_YEARS_EXPERIENCE=1.3
CANDIDATE_LOCATION=Mumbai
CANDIDATE_NOTES=Open to relocation anywhere in India and to remote roles. Targeting 8-10 LPA.

# ---------- Gmail (drafts land here; nothing is ever sent) ----------
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ---------- LLMs (Gemini first, Groq when Gemini runs out) ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_RPM=8
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_RPM=25

# ---------- Contact finders (Apollo first if set, then Hunter) ----------
# Apollo's free plan doesn't include the people search / match APIs - leave empty unless you're on a paid plan.
APOLLO_API_KEY=
HUNTER_API_KEY=
# Free Hunter = 60 searches/month. 2 a day lasts the month; jobs past today's share wait for tomorrow.
# HUNTER_DAILY_SEARCHES=2

# ---------- Search (comma separated; all optional, defaults in app/config.py) ----------
# SEARCH_TERMS=AI Engineer,LLM Engineer,Generative AI Engineer,LangChain,FastAPI,Python Developer
# JOB_SITES=linkedin,naukri,indeed
# RESULTS_PER_SEARCH=20
# HOURS_OLD=72
# MAX_REQUIRED_EXPERIENCE=3
# MIN_CTC_LPA=6
# Never draft to these (substring match on company name) - e.g. your current employer
COMPANY_BLOCKLIST=Quantal

# ---------- Limits ----------
# A ceiling, not a quota: with free Hunter only, expect 2-4 a day (2 Hunter lookups + emails printed in job posts)
# DAILY_DRAFT_TARGET=5
# MIN_SCORE=70
# MAX_JOBS_TO_SCORE=40
# MAX_CONTACT_LOOKUPS=8
# COMPANY_COOLDOWN_DAYS=30
